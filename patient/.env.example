# === SuperShield Patient (built on FarmaWatcher) — environment variables ===
# Copy this file to .env and fill in real values. Everything except openFDA is optional.

# === Data sources ===
# openFDA (no API key required for basic use) — REQUIRED, the live recall feed.
OPENFDA_BASE=https://api.fda.gov
# Optional: raises the rate limit (240/min, 120k/day). Free at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# Shared synthetic/demo recall feed (openFDA drug/enforcement shape), merged with live openFDA.
# Blank = ../shared/fda/demo-recalls.json (repo root shared/fda). Production content: []
SHARED_RECALLS_FILE=
# Patient registry: path to your own JSON [{id, name, drugs[]}, ...].
# Blank = demo registry at demo/seed-data/patients.json
PATIENTS_FILE=
# Notifications store (runtime, gitignored). Blank = demo/seed-data/notifications.json
NOTIFICATIONS_FILE=

# === Monitoring / demo flags ===
# USE_SEED=0 -> live openFDA (default). USE_SEED=1 -> deterministic fixture in demo/seed-data (offline fallback).
USE_SEED=0
# Worker polls every N seconds (0 or blank = single pass).
WORKER_INTERVAL_SEC=60
# In-app alerts ALWAYS work, regardless of this flag or any credentials.
# DRY_RUN=true  -> external delivery (Slack/Gmail via Composio) is not sent; it is logged and labeled "simulated".
# DRY_RUN=false -> external delivery is really sent via Composio (requires COMPOSIO_* below).
DRY_RUN=true
# Dashboard/API port
PORT=3000

# === Claude bulletins (recommended) ===
# Direct Anthropic API; used when no TrueFoundry prompt FQN (LLM_PROMPT_FQN) is configured.
# Without any LLM configured, bulletins fall back to a plain template (the demo never breaks).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# === Optional: LLM via TrueFoundry AI Gateway (OpenAI-compatible) ===
# LLM_BASE_URL must be OpenAI-compatible (include /v1 if the gateway uses it)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Bulletin prompt stored in TrueFoundry (UI: ML Repos -> Prompts). FQN of the version.
LLM_PROMPT_FQN=

# === Optional: Composio (Slack / Gmail delivery) ===
COMPOSIO_API_KEY=
# Slug of the connected user/entity in Composio (the "connected account")
COMPOSIO_USER_ID=default
# Target Slack channel (id or name, e.g. #alerts or C0XXXXXX)
COMPOSIO_SLACK_CHANNEL=
# Gmail recipient
COMPOSIO_GMAIL_TO=

# === Optional: ClickHouse Cloud (event analytics, HTTP interface) ===
# Credentials may be in the URL: https://user:pass@HOST.clickhouse.cloud:8443
# or as query params: https://HOST.clickhouse.cloud:8443/?user=default&password=XXXX
# Blank = events are kept locally (ops event log at /events still works).
CLICKHOUSE_URL=
# Alternative: separate credentials (if not in the URL)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
