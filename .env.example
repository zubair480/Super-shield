# FDA SafetyNet - environment configuration template.
# Copy to .env and fill in. Never commit .env.

# ---------- openFDA ----------
# Optional: raises rate limit (240/min -> 120k/day). Works without it for demo volumes.
OPENFDA_API_KEY=

# ---------- ClickHouse (local default; swap for ClickHouse Cloud) ----------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=safetynet
CLICKHOUSE_SECURE=false

# ---------- Synthetic data scale knobs ----------
SCALE_PHARMACIES=5000
SCALE_CUSTOMERS=1000000
NDC_OVERLAP_RATE=0.18

# ---------- Claude (OpenUI runtime cards + optional Phase 6 agents) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------- Orchestration ----------
USE_AGENTS=false

# ---------- Composio (real pharmacist alert delivery) ----------
# Same names as patient/.env. Leave COMPOSIO_API_KEY empty to keep alerts in-app only.
# The Composio user (COMPOSIO_USER_ID) must have a connected Slack or Gmail account.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default
NOTIFY_CHANNEL=slack
COMPOSIO_SLACK_CHANNEL=
COMPOSIO_GMAIL_TO=
DRY_RUN=false

# ---------- Telegram (pharmacist phone push; overrides NOTIFY_CHANNEL) ----------
# Create a bot with @BotFather, send it /start, then
#   python -c "from phase5_orchestration.tools import real_alert as r; print(r.resolve_chat_id())"
ALERT_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
